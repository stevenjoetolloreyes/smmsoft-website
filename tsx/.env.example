# Turso (production). Leave unset for local dev (falls back to ./local.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Session signing secret (set a long random value in production).
SESSION_SECRET=
# Semaphore upstream key (optional: the admin can also set it in Admin > Platform Settings).
SEMAPHORE_API_KEY=
# LOCAL TEST ONLY: when set to 1, upstream calls hit an in-process mock instead
# of the real Semaphore API. NEVER set this in production.
MOCK_UPSTREAM=
